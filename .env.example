# ── Unibox environment ────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values. NEVER commit .env.local
# (it is gitignored). None of these are NEXT_PUBLIC_* — they are server-only
# secrets and never reach the browser.

# ── Unipile (LinkedIn) ──
UNIPILE_DSN=apiXX.unipile.com:XXXXX
UNIPILE_API_KEY=your_unipile_api_key
UNIPILE_ACCOUNT_ID=your_linkedin_account_id
UNIPILE_SBI_MAILBOX_ID=your_linkedin_page_mailbox_id
UNIPILE_WEBHOOK_SECRET=your_webhook_shared_secret
INBOX_LINKEDIN_SOURCE=real            # 'real' | 'mock'

# ── Unipile (Instagram) ──
UNIPILE_IG_ACCOUNT_ID=your_instagram_account_id
INBOX_INSTAGRAM_SOURCE=real           # 'real' | 'mock'
# Optional overrides ONLY if IG uses a different Unipile account than LinkedIn:
# UNIPILE_IG_API_KEY=
# UNIPILE_IG_DSN=

# ── Freshdesk (support helpdesk) ──
# Admin-level API key. HTTP Basic auth uses this as the username with any dummy
# password (we send "X"). SERVER ONLY — never expose to the client. Find it under
# your Freshdesk Profile Settings → "Your API Key".
FRESHDESK_API_KEY=your_freshdesk_api_key

# ── MySQL / MariaDB (auth + shared workflow state) ──
# Use 127.0.0.1 (not 'localhost') on Hostinger to force IPv4 and match grants.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ── Public app URL (for invite links). Set to your real domain. ──
APP_URL=https://your-domain.com

# ── Dev-only auth bypass ──
# Set to 'true' to skip the login gate while testing on localhost — every
# request is treated as a built-in admin. HARD-GATED to non-production: it is
# ignored when NODE_ENV=production, so it can never disable auth on a deploy.
# Leave unset/false normally.
# DISABLE_AUTH=true
